# Token du bot (portail développeur Discord > ton application > Bot > Reset Token)
DISCORD_TOKEN=

# ID de l'application (portail développeur > General Information > Application ID)
CLIENT_ID=

# ID du serveur : les commandes apparaissent instantanément (sinon elles mettent jusqu'à 1 h)
GUILD_ID=

# Facultatif : port d'un petit serveur de statut, pour les hébergeurs qui l'exigent
# (Render, Koyeb…). Laisse vide sur Railway, Fly.io, un VPS ou ton ordinateur.
PORT=

# Facultatif : URL de l'image de bannière affichée au-dessus des photos et vidéos.
# /banniere te donne cette valeur. Sans elle, le bot lit data/branding.json.
BANNER_URL=
